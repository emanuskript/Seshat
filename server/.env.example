# Copy to server/.env for local development. The production deployment script
# writes a root-owned environment file under /etc/seshat instead.
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGIN=http://localhost:8081
DATABASE_URL=postgresql://seshat:replace-me@127.0.0.1:5432/seshat?schema=public
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
SESSION_RETENTION_DAYS=90

# Used by server/docker-compose.yml for a local development database.
POSTGRES_USER=seshat
POSTGRES_DB=seshat
POSTGRES_PASSWORD=replace-with-a-strong-random-password
PGADMIN_DEFAULT_EMAIL=admin@example.invalid
PGADMIN_DEFAULT_PASSWORD=replace-with-a-different-strong-password
